          },
          "http": {
            "method": "GET",
            "url": "https://identify-eu-west-1.acrcloud.com/api/buckets",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
