              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a bucket."
        },
        {
          "info": {
            "name": "Update a bucket.",
            "type": "http"
          },
          "http": {
