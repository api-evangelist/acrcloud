            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://identify-eu-west-1.acrcloud.com/api/buckets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
