              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a bucket."
        },
        {
          "info": {
            "name": "Retrieve a bucket.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://identify-eu-west-1.acrcloud.com/api/buckets/:id",
            "params": [
              {
                "name": "id",
                "value": "",
